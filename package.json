{
  "name": "collabboard",
  "private": true,
  "version": "1.0.0",
  "description": "A real-time collaborative whiteboard with role-based sharing, snapshots, and chart embeds, built with React 19, Supabase, Fabric.js, and Liveblocks.",
  "keywords": [
    "react",
    "typescript",
    "whiteboard",
    "collaboration",
    "canvas",
    "fabricjs",
    "liveblocks",
    "real-time"
  ],
  "author": "CollabBoard Team",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@liveblocks/client": "^3.13.2",
    "@liveblocks/node": "^3.22.0",
    "@liveblocks/react": "^3.13.2",
    "@supabase/supabase-js": "^2.78.0",
    "antd": "^5.24.9",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.4",
    "fabric": "^7.4.0",
    "file-saver": "^2.0.5",
    "lz-string": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "uuid": "^11.1.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
